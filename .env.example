# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Relay (shared secret between Supabase Edge Functions and Cloudflare Worker)
RELAY_JWT_SECRET=generate-a-long-random-string-min-32-chars

# Web (Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_RELAY_URL=wss://relay.ownmyownai.app/v1/connect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runner (build-time / config)
RUNNER_SUPABASE_URL=https://your-project.supabase.co
RUNNER_RELAY_URL=wss://relay.ownmyownai.app/v1/connect
RUNNER_APP_URL=http://localhost:3000

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwnMyOwnAI Host",
  "version": "0.1.0",
  "identifier": "app.ownmyownai.runner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OwnMyOwnAI Host",
        "width": 480,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
